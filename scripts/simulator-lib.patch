+  static constexpr uint16_t DISPLAY_WIDTH = EINK_DISPLAY_WIDTH;
+  static constexpr uint16_t DISPLAY_HEIGHT = EINK_DISPLAY_HEIGHT;
 #else
   static constexpr uint16_t DISPLAY_WIDTH = 800;
